          "value": "splitv"
        },
        {
          "type": "STRING",
          "value": "sticky"
        },
        {
          "type": "STRING",
          "value": "resize"
        },
        {
          "type": "STRING",
          "value": "kill"
        },
        {
          "type": "STRING",
          "value": "reload"
        },
        {
          "type": "STRING",
          "value": "restart"
        },
        {
          "type": "STRING",
          "value": "exit"
        },
        {
          "type": "STRING",
          "value": "fullscreen"
        },
        {
          "type": "STRING",
          "value": "floating"
        },
        {
          "type": "STRING",
          "value": "input"
        },
        {
          "type": "STRING",
          "value": "seat"
        },
        {
          "type": "STRING",
          "value": "xwayland"
        },
        {
          "type": "STRING",
          "value": "titlebar_border_thickness"
        },
        {
          "type": "STRING",
          "value": "titlebar_padding"
        },
        {
          "type": "STRING",
          "value": "title_format"
        },
        {
          "type": "STRING",
          "value": "title_align"
        },
        {
          "type": "STRING",
          "value": "client.focused"
        },
        {
          "type": "STRING",
          "value": "client.focused_inactive"
        },
        {
          "type": "STRING",
          "value": "client.unfocused"
        },
        {
          "type": "STRING",
          "value": "client.urgent"
        },
        {
          "type": "STRING",
          "value": "client.placeholder"
        },
        {
          "type": "STRING",
          "value": "client.background"
        },
        {
          "type": "STRING",
          "value": "swaybg_command"
        },
        {
          "type": "STRING",
          "value": "swaynag_command"
        },
        {
          "type": "STRING",
          "value": "unbindsym"
        },
        {
          "type": "STRING",
          "value": "bindswitch"
        },
        {
          "type": "STRING",
          "value": "tiling_drag"
        },
        {
          "type": "STRING",
          "value": "show_marks"
        },
        {
          "type": "STRING",
          "value": "workspace_auto_back_and_forth"
        },
        {
          "type": "STRING",
          "value": "position"
        },
        {
          "type": "STRING",
          "value": "status_command"
        },
        {
          "type": "STRING",
          "value": "xkb_layout"
        },
        {
          "type": "STRING",
          "value": "xkb_options"
        },
        {
          "type": "STRING",
          "value": "xkb_variant"
        },
        {
          "type": "STRING",
          "value": "xkb_model"
        },
        {
          "type": "STRING",
          "value": "resolution"
        },
        {
          "type": "STRING",
          "value": "mode"
        }
      ]
    },
    "keycombo": {
      "type": "PATTERN",
      "value": "(\\$[a-zA-Z_][a-zA-Z0-9_]*\\+)?[a-zA-Z0-9_+]+"
    },
    "flag": {
      "type": "PATTERN",
      "value": "--[a-zA-Z0-9_-]+"
    },
    "variable": {
      "type": "PATTERN",
      "value": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "variable"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "color"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "unit_value"
        },
        {
          "type": "SYMBOL",
          "name": "word"
        }
      ]
    },
    "number": {
      "type": "PATTERN",
      "value": "\\d+"
    },
    "unit_value": {
      "type": "PATTERN",
      "value": "\\d+(?:px|ppt|%)"
    },
    "color": {
      "type": "PATTERN",
      "value": "#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?"
    },
    "string": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[^\"\\\\]+"
              },
              {
                "type": "SYMBOL",
                "name": "escape_sequence"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "escape_sequence": {
      "type": "PATTERN",
      "value": "\\\\."
    },
    "command": {
      "type": "PATTERN",
      "value": "[^\\n]+"
    },
    "word": {
      "type": "PATTERN",
      "value": "[^\\s\\[\\]{}#\"\\n][^\\s\\[\\]{}#\"\\n]*"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t]"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": []
}
