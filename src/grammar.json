{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "i3config",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "statement"
          },
          {
            "type": "PATTERN",
            "value": "\\r?\\n"
          }
        ]
      }
    },
    "statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "comment"
            },
            {
              "type": "SYMBOL",
              "name": "set_statement"
            },
            {
              "type": "SYMBOL",
              "name": "bindsym_statement"
            },
            {
              "type": "SYMBOL",
              "name": "bindcode_statement"
            },
            {
              "type": "SYMBOL",
              "name": "exec_statement"
            },
            {
              "type": "SYMBOL",
              "name": "exec_always_statement"
            },
            {
              "type": "SYMBOL",
              "name": "assign_statement"
            },
            {
              "type": "SYMBOL",
              "name": "for_window_statement"
            },
            {
              "type": "SYMBOL",
              "name": "no_focus_statement"
            },
            {
              "type": "SYMBOL",
              "name": "criteria_command"
            },
            {
              "type": "SYMBOL",
              "name": "bar_block"
            },
            {
              "type": "SYMBOL",
              "name": "block_statement"
            },
            {
              "type": "SYMBOL",
              "name": "include_statement"
            },
            {
              "type": "SYMBOL",
              "name": "command_statement"
            }
          ]
        },
        {
          "type": "PATTERN",
          "value": "\\r?\\n"
        }
      ]
    },
    "comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "#"
        },
        {
          "type": "PATTERN",
          "value": "[^\\n]*"
        }
      ]
    },
    "set_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "set"
        },
        {
          "type": "SYMBOL",
          "name": "variable"
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "SYMBOL",
            "name": "value"
          }
        }
      ]
    },
    "bindsym_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "bindsym"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "flag"
          }
        },
        {
          "type": "SYMBOL",
          "name": "keycombo"
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "SYMBOL",
            "name": "value"
          }
        }
      ]
    },
    "bindcode_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "bindcode"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "flag"
          }
        },
        {
          "type": "SYMBOL",
          "name": "keycombo"
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "SYMBOL",
            "name": "value"
          }
        }
      ]
    },
    "exec_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "exec"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "flag"
          }
        },
        {
          "type": "SYMBOL",
          "name": "command"
        }
      ]
    },
    "exec_always_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "exec_always"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "flag"
          }
        },
        {
          "type": "SYMBOL",
          "name": "command"
        }
      ]
    },
    "assign_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "assign"
        },
        {
          "type": "SYMBOL",
          "name": "criteria"
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "SYMBOL",
            "name": "value"
          }
        }
      ]
    },
    "for_window_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "for_window"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "criteria"
                },
                {
                  "type": "REPEAT1",
                  "content": {
                    "type": "SYMBOL",
                    "name": "value"
                  }
                }
              ]
            },
            {
              "type": "SYMBOL",
              "name": "for_window_block"
            }
          ]
        }
      ]
    },
    "for_window_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "PATTERN",
          "value": "\\r?\\n"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "statement"
              },
              {
                "type": "PATTERN",
                "value": "\\r?\\n"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "no_focus_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "no_focus"
        },
        {
          "type": "SYMBOL",
          "name": "criteria"
        }
      ]
    },
